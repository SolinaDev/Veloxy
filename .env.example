# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Firebase (Console do Firebase > Configuracoes do projeto > Seus apps).
# Nenhum destes valores e secreto: sao identificadores de cliente, protegidos
# pelas regras do Firestore/Storage e pelas restricoes de dominio/pacote do
# proprio Firebase — mas o arquivo .env.local continua fora do git mesmo assim.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
